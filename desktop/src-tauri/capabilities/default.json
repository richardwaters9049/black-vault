{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop",
  "description": "Allow the main local window to use local vault lifecycle commands and native file selection.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-biometric-status",
    "allow-get-desktop-info",
    "allow-select-file",
    "allow-list-vaults",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-import-vault-file",
    "allow-describe-dropped-file",
    "allow-import-dropped-file",
    "allow-import-example-file",
    "allow-delete-locked-vault",
    "allow-list-vault-files",
    "allow-list-nested-vaults",
    "allow-lock-selected-files",
    "allow-unlock-nested-vault",
    "allow-restore-nested-vault",
    "allow-create-nested-text-file",
    "allow-manage-nested-file",
    "allow-transfer-parent-file-to-nested",
    "allow-read-nested-text-file",
    "allow-create-vault-text-file",
    "allow-read-vault-text-file",
    "allow-update-vault-text-file",
    "allow-delete-vault-file",
    "allow-decrypt-vault-file",
    "allow-export-vault-file",
    "allow-get-public-identity",
    "allow-list-contacts",
    "allow-import-contact-identity",
    "allow-verify-contact-fingerprint",
    "allow-revoke-contact",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
